# SwachhAI Environment Configuration

# Server & Security
SECRET_KEY=swachhai_super_secret_production_jwt_key_replace_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite (ready for zero-setup local dev)
DATABASE_URL=sqlite:///./swachhai.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://swachhai_user:swachhai_pass@localhost:5432/swachhai_db

# Storage
MAX_FILE_SIZE_MB=15

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
